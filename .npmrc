# Force a flat (hoisted) node_modules layout everywhere (local + Vercel),
# matching the intent already declared in pnpm-workspace.yaml.
# Some pnpm entrypoints/versions ignore those workspace-yaml keys, which caused
# TS2307 on Vercel for transitive-only imports (e.g. @voidzero-dev/vite-plus-core).
node-linker=hoisted
shamefully-hoist=true
